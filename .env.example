# EcoSync Resource Manager — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is already git-ignored.

# ── IBM watsonx.ai credentials ───────────────────────────────────────────────
# All three are required to enable IBM Granite mode.
# When any are absent the app runs in "Local grounded fallback" mode.
WATSONX_APIKEY=your-ibm-cloud-api-key-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-watsonx-project-uuid-here

# ── IBM Granite model selection (optional — defaults shown) ───────────────────
GRANITE_MODEL_ID=ibm/granite-3-3-8b-instruct
GRANITE_MAX_NEW_TOKENS=600
GRANITE_TEMPERATURE=0.2
